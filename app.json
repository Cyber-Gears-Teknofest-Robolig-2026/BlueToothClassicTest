{
  "expo": {
    "name": "BlueTooth Classic Test",
    "slug": "BlueToothClassicTest",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#ffffff",
      "image": "./assets/images/icon.png",
      "imageWidth": 200,
      "dark": {
        "image": "./assets/images/icon.png",
        "backgroundColor": "#cccccc",
        "imageWidth": 200
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cybergears.BlueToothClassicTest",
      "splash": {
        "backgroundColor": "#ffffff",
        "image": "./assets/images/icon.png",
        "imageWidth": 200,
        "dark": {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#cccccc",
          "imageWidth": 200
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "backgroundColor": "#ffffff",
        "image": "./assets/images/icon.png",
        "imageWidth": 200,
        "dark": {
          "image": "./assets/images/icon.png",
          "backgroundColor": "#cccccc",
          "imageWidth": 200
        }
      },
      "package": "com.cybergears.BlueToothClassicTest",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    }
  }
}
