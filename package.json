{
  "name": "bluetoothclassictest",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "start": "dotenv -- cross-var expo start --host %EXPO_PUBLIC_HOST% --port %EXPO_PUBLIC_PORT% %EXPO_PUBLIC_LAUNCH_MODE%",
    "android": "dotenv -- cross-var expo start --android --host %EXPO_PUBLIC_HOST% --port %EXPO_PUBLIC_PORT% %EXPO_PUBLIC_LAUNCH_MODE%",
    "ios": "dotenv -- cross-var expo start --ios --host %EXPO_PUBLIC_HOST% --port %EXPO_PUBLIC_PORT% %EXPO_PUBLIC_LAUNCH_MODE%",
    "web": "dotenv -- cross-var expo start --web --host %EXPO_PUBLIC_HOST% --port %EXPO_PUBLIC_PORT% %EXPO_PUBLIC_LAUNCH_MODE%",
    "prebuild": "expo prebuild",
    "build-android-debug": "cd android && gradlew assembleDebug",
    "build-android-release": "cd android && gradlew assembleRelease",
    "install-android-debug": "cd android && gradlew installDebug",
    "install-android-release": "cd android && gradlew installRelease",
    "build-android-clean": "cd android && gradlew clean",
    "build-web": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.14.14",
    "buffer": "^6.0.3",
    "expo": "^55.0.25",
    "expo-dev-client": "~55.0.35",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-bluetooth-classic": "^1.73.0-rc.17",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "cross-var": "^1.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
